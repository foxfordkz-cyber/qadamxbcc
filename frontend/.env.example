# Explicit demo API; data is in memory, resets on server restart, and is not banking data.
BCC_API_MODE=demo
# Set BCC_API_MODE=live to forward requests to the existing FastAPI backend.
BCC_API_URL=http://127.0.0.1:8000
# Live mode presets require existing, appropriately seeded backend accounts.
BCC_NORMAL_SENDER_ID=
BCC_NORMAL_RECIPIENT_PHONE=
BCC_SCAM_SENDER_ID=
BCC_SCAM_RECIPIENT_PHONE=
BCC_HUB_SENDER_ID=
BCC_HUB_RECIPIENT_PHONE=
# Optional server-side PAN-to-account mapping; use test cards only in this simulator.
BCC_CARD_ACCOUNT_MAP={}
