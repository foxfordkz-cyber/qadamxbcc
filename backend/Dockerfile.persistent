FROM node:22-bookworm-slim AS wallet
WORKDIR /src/android-app
COPY android-app/package*.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY android-app/www ./www
COPY android-app/scripts/vendor.mjs android-app/scripts/build-wallet.mjs ./scripts/
COPY deliverables/android/Saq-Bol-Android-2.7.apk /src/backend/.qadam-web/install/Saq-Bol-Android-2.7.apk
COPY deliverables/android/Saq-Bol-Android-2.7.json /src/backend/.qadam-web/install/Saq-Bol-Android-2.7.json
RUN npm run web

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 UV_PROJECT_ENVIRONMENT=/opt/venv PATH="/opt/venv/bin:$PATH"
WORKDIR /app
RUN pip install --no-cache-dir "uv>=0.8"
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev
COPY backend/app ./app
COPY backend/scripts ./scripts
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./
COPY --from=wallet /src/backend/.qadam-web ./.qadam-web
RUN python -m scripts.train_fraud_model \
    && chmod 0444 app/ml/fraud_model.joblib \
    && useradd --create-home qadam
USER qadam
EXPOSE 10000
CMD ["sh", "scripts/start-persistent.sh", "api"]
