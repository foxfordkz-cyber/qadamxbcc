# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS wallet
WORKDIR /src/android-app
COPY android-app/package*.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY android-app/www ./www
COPY android-app/scripts/vendor.mjs android-app/scripts/build-wallet.mjs android-app/scripts/stage-installer.mjs ./scripts/
ARG APK_API_ORIGIN=https://saq-bol-mobile.onrender.com
RUN --mount=type=bind,source=frontend/public/downloads,target=/releases \
    node scripts/stage-installer.mjs package.json /releases ../backend/.qadam-web/install "$APK_API_ORIGIN"
RUN npm run web && test -s ../backend/.qadam-web/install/index.html

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv PATH="/opt/venv/bin:$PATH"

RUN apt-get update && apt-get install -y --no-install-recommends redis-server \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir "uv>=0.8"
WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --group mobile-ephemeral
COPY backend/app ./app
COPY backend/scripts ./scripts
COPY docs/evidence/scenario_stand.json ./scenario_stand.json
COPY frontend/src/lib/scenario-signals.json ./scenario-signals.json
COPY --from=wallet /src/backend/.qadam-web ./.qadam-web
RUN useradd --create-home mobile && python -m scripts.train_fraud_model \
    && chmod 0444 /app/app/ml/fraud_model.joblib
USER mobile
EXPOSE 8000
CMD ["python", "-m", "scripts.mobile_ephemeral"]
