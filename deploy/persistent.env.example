# Names for the existing host's secret editor. Do not fill and commit this file.
# Render supplies both private connection strings from the blueprint.
DATABASE_URL=postgresql://USER:PASSWORD@PRIVATE_HOST/qadam
BCC_REDIS_URL=redis://PRIVATE_HOST:6379/0
BCC_ENVIRONMENT=demo
BCC_MOBILE_ENABLED=true
BCC_MOBILE_AUTH_MODE=password
BCC_MOBILE_EPHEMERAL_STORE=false
# Use the existing password encoder; these are hashes, not plaintext passwords.
BCC_MOBILE_CLIENT_HASH=
BCC_MOBILE_ADMIN_HASH=
# Optional third role, disabled when absent. Never reuse the SOC password hash.
BCC_MOBILE_PLATFORM_HASH=
BCC_INTEGRATIONS_ENABLED=true
BCC_INTEGRATIONS_ENVIRONMENT=test
BCC_INTEGRATIONS_SIGNING_KEY=
BCC_INTEGRATIONS_TELEGRAM_MODE=fake
# Only after consent: test mode, server-only bot token and confirmed private IDs.
BCC_INTEGRATIONS_TELEGRAM_TOKEN=
BCC_INTEGRATIONS_TELEGRAM_ALLOWED_CHAT_IDS=[]
BCC_MOBILE_TELEGRAM_USERNAME=
# Native build, not an end-user input. Confirm the service before distribution.
QADAM_API_ORIGIN=https://saq-bol-mobile.onrender.com
